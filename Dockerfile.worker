# syntax=docker/dockerfile:1
# The worker process, and the one-shot database setup (`pnpm db:setup`).
# tsx is a runtime dependency, so TypeScript runs directly without a build step.

FROM node:24-slim
RUN npm install -g pnpm@10.32.1
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod
COPY tsconfig.json ./
COPY drizzle ./drizzle
COPY src ./src
USER node
CMD ["pnpm", "worker"]
