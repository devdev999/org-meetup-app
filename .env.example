# Copy to .env for local development. compose.yaml sets its own values.

# Postgres. The compose file publishes Postgres on 5439 so it does not clash with other projects.
DATABASE_URL=postgres://postgres:postgres@localhost:5439/org_meetup
# Tests create throw-away databases through this admin connection.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5439/postgres

# Web process
APP_URL=http://localhost:3000
# At least 32 characters; seals the session cookie. Generate one: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# oidc (default) uses each Organisation's real issuer. fake is an in-memory issuer for local runs: anyone can sign in as anyone.
IDENTITY_PROVIDER=fake

AI_PROVIDER=memory
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

TELEGRAM_PROVIDER=memory
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_PROVIDER=memory
SMTP_URL=
EMAIL_FROM=

# Bootstrap: the first Organisation, its OIDC settings and the first Platform Admin.
# Leave all BOOTSTRAP_ variables unset to skip. The issuer below is the built-in fake issuer's name; with
# IDENTITY_PROVIDER=oidc use your real issuer, client id and secret.
BOOTSTRAP_ORGANISATION_SLUG=ministry-a
BOOTSTRAP_ORGANISATION_NAME=Ministry A
# Optional JSON arrays, added without removing existing choices. Supply your Organisation's lists
# here when its issuer does not provide Department or Site claims.
BOOTSTRAP_DEPARTMENTS='["Finance","Legal"]'
BOOTSTRAP_SITES='["Harbour House"]'
BOOTSTRAP_OIDC_ISSUER=http://localhost:3000/dev-idp
BOOTSTRAP_OIDC_CLIENT_ID=org-meetups
BOOTSTRAP_OIDC_CLIENT_SECRET=
# Which claims carry each piece of Member data. Department, Site and staff identifier are optional.
BOOTSTRAP_OIDC_CLAIM_EMAIL=email
BOOTSTRAP_OIDC_CLAIM_NAME=name
BOOTSTRAP_OIDC_CLAIM_DEPARTMENT=department
BOOTSTRAP_OIDC_CLAIM_SITE=site
BOOTSTRAP_OIDC_CLAIM_STAFF_IDENTIFIER=
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=pat@ministry-a.example
BOOTSTRAP_PLATFORM_ADMIN_NAME=Pat Platform
BOOTSTRAP_ORGANISATION_ADMIN_EMAIL=olivia@ministry-a.example
BOOTSTRAP_ORGANISATION_ADMIN_NAME=Olivia Admin
